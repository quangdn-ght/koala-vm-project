#!/bin/bash

################################################################################
# ChebiChat VM Manager - Main Entry Point
# Centralized script to manage ChebiChat VM operations
################################################################################

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# VM Configuration
VM_NAME="chebichat"
IP_PRIMARY="10.168.1.59"

show_help() {
    echo ""
    echo -e "${BLUE}╔═══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║                  ChebiChat VM Manager                         ║${NC}"
    echo -e "${BLUE}╚═══════════════════════════════════════════════════════════════╝${NC}"
    echo -e "  Centralized tool for managing ChebiChat virtual machine"
    echo ""
    
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  USAGE${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ./chebichat-vm ${YELLOW}<command>${NC} [options]"
    echo ""

    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  VM MANAGEMENT COMMANDS${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}ssh${NC}                 SSH into the ChebiChat VM"
    echo -e "  ${YELLOW}start${NC}               Start the VM"
    echo -e "  ${YELLOW}stop${NC}                Stop the VM gracefully"
    echo -e "  ${YELLOW}restart${NC}             Restart the VM"
    echo -e "  ${YELLOW}destroy${NC}             Force stop the VM"
    echo -e "  ${YELLOW}status${NC}              Show VM status and info"
    echo -e "  ${YELLOW}ip${NC}                  Get VM IP address"
    echo -e "  ${YELLOW}console${NC}             Access VM serial console (Ctrl+] to exit)"
    echo -e "  ${YELLOW}list${NC}                List all VMs"
    echo ""

    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  DOCKER & ENVIRONMENT${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}docker${NC}              Check Docker and Docker Compose versions"
    echo -e "  ${YELLOW}containers${NC}          List running containers"
    echo -e "  ${YELLOW}ping${NC}                Test network connectivity"
    echo ""

    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  EXAMPLES${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${YELLOW}./chebichat-vm ssh${NC}                       SSH to VM"
    echo -e "  ${YELLOW}./chebichat-vm status${NC}                    Check VM status"
    echo -e "  ${YELLOW}./chebichat-vm docker${NC}                    Check Docker version"
    echo -e "  ${YELLOW}./chebichat-vm containers${NC}                List containers"
    echo ""
    
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  VM SPECIFICATIONS${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  CPUs:      16 cores"
    echo -e "  RAM:       16 GB"
    echo -e "  Disk:      128 GB"
    echo -e "  Network:   br0 (10.168.1.59/24)"
    echo -e "  Docker:    v29.1.3"
    echo -e "  Compose:   v5.0.1"
    echo ""
}

# Main command dispatcher
case "${1:-}" in
    ssh)
        ssh -o ConnectTimeout=5 ght@"$IP_PRIMARY"
        ;;
    start)
        echo -e "${GREEN}Starting $VM_NAME VM...${NC}"
        sudo virsh start "$VM_NAME"
        ;;
    stop)
        echo -e "${YELLOW}Stopping $VM_NAME VM...${NC}"
        sudo virsh shutdown "$VM_NAME"
        ;;
    restart)
        echo -e "${YELLOW}Restarting $VM_NAME VM...${NC}"
        sudo virsh reboot "$VM_NAME"
        ;;
    destroy)
        echo -e "${RED}Force stopping $VM_NAME VM...${NC}"
        sudo virsh destroy "$VM_NAME"
        ;;
    status)
        echo -e "${GREEN}VM Status:${NC}"
        sudo virsh dominfo "$VM_NAME"
        echo ""
        echo -e "${GREEN}Network Info:${NC}"
        echo "IP Address: $IP_PRIMARY"
        echo ""
        echo -e "${GREEN}Resources:${NC}"
        ssh -o ConnectTimeout=5 ght@"$IP_PRIMARY" 'echo "CPUs: $(nproc)" && echo "RAM: $(free -h | grep Mem | awk "{print \$2}")" && echo "Disk: $(df -h / | tail -1 | awk "{print \$2}")"'
        ;;
    ip)
        echo -e "${GREEN}VM IP Address:${NC}"
        echo "$IP_PRIMARY"
        sudo virsh domifaddr "$VM_NAME" 2>/dev/null || true
        ;;
    console)
        echo -e "${YELLOW}Connecting to serial console... (Press Ctrl+] to exit)${NC}"
        sudo virsh console "$VM_NAME"
        ;;
    list)
        sudo virsh list --all
        ;;
    docker)
        echo -e "${GREEN}Checking Docker versions...${NC}"
        ssh -o ConnectTimeout=5 ght@"$IP_PRIMARY" 'docker --version && docker compose version'
        ;;
    containers)
        echo -e "${GREEN}Running containers:${NC}"
        ssh -o ConnectTimeout=5 ght@"$IP_PRIMARY" 'sudo docker ps'
        ;;
    ping)
        echo "Testing network connectivity..."
        echo -n "IP ($IP_PRIMARY): "
        if ping -c 3 -W 2 "$IP_PRIMARY" > /dev/null 2>&1; then
            echo -e "${GREEN}✓ OK${NC}"
        else
            echo -e "${RED}✗ FAILED${NC}"
        fi
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Error: Unknown command '${1}'${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
