GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Keep (chưa bật Telegram). Chi tiết: keep/.env.example
# KEEP_IMAGE_TAG=0.54.2
# KEEP_UI_PORT=3001
# KEEP_API_PORT=8080
# KEEP_WS_PORT=6001
# KEEP_NEXTAUTH_URL=http://10.168.1.2:3001
# KEEP_PUBLIC_API_URL=http://10.168.1.2:8080
# KEEP_PUSHER_HOST=10.168.1.2
# AUTH_TYPE=DB
# KEEP_DEFAULT_USERNAME=keep
# KEEP_DEFAULT_PASSWORD=changeme-keep-admin
# KEEP_JWT_SECRET=changeme-keep-jwt-64chars-minimum-please-rotate
# NEXTAUTH_SECRET=changeme-nextauth-secret-rotate
# KEEP_DEFAULT_API_KEYS=alertmanager:webhook:changeme-keep-webhook-key
# KEEP_WEBHOOK_API_KEY=changeme-keep-webhook-key
# Telegram qua Keep. Chỉ critical/high và cảnh báo nhiệt độ (warning khác không gửi).
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
