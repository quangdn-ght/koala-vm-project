          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(node_cpu_seconds_total{vm=\"$vm\",mode=\"iowait\"}[2m])",
          "legendFormat": "iowait",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(node_cpu_seconds_total{vm=\"$vm\",mode=\"steal\"}[2m])",
          "legendFormat": "steal",
          "refId": "D",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
