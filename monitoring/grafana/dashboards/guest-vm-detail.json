    {
      "id": 13,
      "title": "CPU % (guest node_exporter + libvirt)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg without (cpu,mode) (rate(node_cpu_seconds_total{vm=\"$vm\",mode=\"idle\"}[2m])))",
          "legendFormat": "guest OS",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
