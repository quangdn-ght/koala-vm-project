    {
      "id": 6,
      "title": "All physical hosts \u2014 CPU, RAM, disk, temp, probes",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox-icmp\",role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"blackbox-ssh\",role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (host) (probe_success{job=\"blackbox-http\",role=\"physical\"})",
          "legendFormat": "{{host}}",
          "refId": "J",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{role=\"physical\",mode=\"idle\"}[2m])))",
          "legendFormat": "{{host}}",
          "refId": "D",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "physical:mem_used_ratio",
          "legendFormat": "{{host}}",
          "refId": "E",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "physical:root_disk_used_ratio",
          "legendFormat": "{{host}}",
          "refId": "F",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "G",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count without(cpu,mode) (node_cpu_seconds_total{role=\"physical\",mode=\"idle\"})",
          "legendFormat": "{{host}}",
          "refId": "H",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_uname_info{role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "I",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "physical:cpu_temp_celsius{role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "K",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "physical:nvme_temp_celsius{role=\"physical\"}",
          "legendFormat": "{{host}}",
          "refId": "L",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
