            },
            "indexByName": {
              "host": 0,
              "exporter": 1,
              "ICMP": 2,
              "SSH": 3,
              "HTTP": 4,
              "CPUs": 5,
              "CPU %": 6,
              "RAM total": 7,
              "RAM": 8,
              "disk /": 9,
              "CPU \u00b0C": 10,
              "NVMe \u00b0C": 11
            }
          }
        }
