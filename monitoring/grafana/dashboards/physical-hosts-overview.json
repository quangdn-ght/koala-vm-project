              "Value #B": "ICMP",
              "Value #C": "SSH",
              "Value #J": "HTTP",
              "Value #D": "CPU %",
              "Value #E": "RAM",
              "Value #F": "disk /",
              "Value #G": "RAM total",
              "Value #H": "CPUs",
              "Value #I": "uname",
              "Value #K": "CPU \u00b0C",
